# Satış sitesi ortam değişkenleri. Gerçek değerleri .env.local içine yazın; bu dosyaya sır yazılmaz.

# Çekirdek uygulamanın adresi (iç ağ adresi önerilir). Sondaki "/" atılır.
CORE_API_URL=http://localhost:3070

# Çekirdekle paylaşılan sır (en az 32 karakter). Yalnızca sunucuda kalır; NEXT_PUBLIC_ önekiyle verilmez.
SALES_API_SECRET=yerel-gelistirme-icin-en-az-32-karakterlik-ornek-deger

# Sitenin herkese açık adresi. Üretimde https:// olmalıdır.
SITE_URL=http://localhost:3370

# İstemci IP adresini taşıyan güvenilir vekil başlığı (ör. x-real-ip). Üretimde zorunludur.
# Yerelde boş bırakılırsa tüm kullanıcılar tek hız sınırı kovasını paylaşır.
TRUSTED_IP_HEADER=
