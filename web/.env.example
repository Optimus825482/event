DATABASE_URL=postgres://postgres@localhost:54329/eventflow_dev
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
UPLOAD_DIR=./uploads
# İstemci IP'sini taşıyan, ters vekilin yazdığı başlık; üretimde zorunlu (Traefik arkasında: x-real-ip).
TRUSTED_IP_HEADER=
# Ayarlardaki SMTP parolasını şifreler: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
# Rezervasyon QR belirteçlerinin HMAC anahtarı (en az 32 karakter): openssl rand -base64 32
# Boşsa BETTER_AUTH_SECRET'tan türetilir; değiştirilirse daha önce dağıtılmış QR'lar geçersiz olur.
QR_SIGNING_KEY=
